      }
    },
    {
      "name": "ratings_by_year",
      "displayName": "Ratings Trend by Year",
      "queryLines": [
        "SELECT\n",
        "  original_publication_year as publication_year,\n",
        "  AVG(average_rating) as avg_rating,\n",
        "  COUNT(*) as book_count,\n",
        "  SUM(ratings_count) as total_ratings\n",
        "FROM\n",
        "  workspace.default.dim_books\n",
        "WHERE\n",
        "  original_publication_year IS NOT NULL\n",
        "  AND original_publication_year >= 1900\n",
        "  AND original_publication_year <= 2026\n",
        "GROUP BY\n",
        "  original_publication_year\n",
        "ORDER BY\n",
        "  original_publication_year"
      ],
      "catalog": "workspace",
      "schema": "default"
    },
    {
      "name": "top_authors",
      "displayName": "Top Authors",
      "queryLines": [
        "SELECT\n",
        "  authors[0] as author,\n",
        "  COUNT(*) as book_count,\n",
        "  AVG(average_rating) as avg_rating,\n",
        "  SUM(ratings_count) as total_ratings\n",
        "FROM\n",
        "  workspace.default.dim_books\n",
        "WHERE\n",
        "  authors[0] IS NOT NULL\n",
        "GROUP BY\n",
        "  authors[0]\n",
        "HAVING\n",
        "  COUNT(*) >= 5\n",
        "ORDER BY\n",
        "  book_count DESC\n",
        "LIMIT 20"
      ],
      "catalog": "workspace",
      "schema": "default"
    },
    {
      "name": "key_metrics",
      "displayName": "Key Metrics",
      "queryLines": [
        "SELECT\n",
        "  COUNT(*) as total_books,\n",
        "  AVG(average_rating) as overall_avg_rating,\n",
        "  SUM(ratings_count) as total_ratings\n",
        "FROM\n",
        "  workspace.default.dim_books"
      ],
      "catalog": "workspace",
      "schema": "default"
    },
    {
      "name": "top_books",
      "displayName": "Top Rated Books",
      "queryLines": [
        "SELECT\n",
        "  title,\n",
        "  authors[0] as author,\n",
        "  average_rating,\n",
        "  ratings_count,\n",
        "  original_publication_year\n",
        "FROM\n",
        "  workspace.default.dim_books\n",
        "WHERE\n",
        "  ratings_count >= 1000\n",
        "ORDER BY\n",
        "  average_rating DESC,\n",
        "  ratings_count DESC\n",
        "LIMIT 20"
      ],
      "catalog": "workspace",
      "schema": "default"
    },
    {
      "name": "books_by_decade",
      "displayName": "Books by Decade",
      "queryLines": [
        "SELECT\n",
        "  CONCAT(CAST(FLOOR(original_publication_year / 10) * 10 AS STRING), 's') as decade,\n",
        "  COUNT(*) as book_count,\n",
        "  AVG(average_rating) as avg_rating\n",
        "FROM\n",
        "  workspace.default.dim_books\n",
        "WHERE\n",
        "  original_publication_year IS NOT NULL\n",
        "  AND original_publication_year >= 1900\n",
        "  AND original_publication_year <= 2026\n",
        "GROUP BY\n",
        "  FLOOR(original_publication_year / 10) * 10\n",
        "ORDER BY\n",
        "  FLOOR(original_publication_year / 10) * 10"
      ],
      "catalog": "workspace",
      "schema": "default"
    },
    {
      "name": "rating_distribution",
      "displayName": "Rating Distribution",
      "queryLines": [
        "SELECT\n",
        "  CASE\n",
        "    WHEN average_rating >= 4.5 THEN '4.5-5.0'\n",
        "    WHEN average_rating >= 4.0 THEN '4.0-4.5'\n",
        "    WHEN average_rating >= 3.5 THEN '3.5-4.0'\n",
        "    WHEN average_rating >= 3.0 THEN '3.0-3.5'\n",
        "    WHEN average_rating >= 2.5 THEN '2.5-3.0'\n",
        "    WHEN average_rating >= 2.0 THEN '2.0-2.5'\n",
        "    ELSE '0.0-2.0'\n",
        "  END as rating_range,\n",
        "  COUNT(*) as book_count\n",
        "FROM\n",
        "  workspace.default.dim_books\n",
        "WHERE\n",
        "  average_rating IS NOT NULL\n",
        "GROUP BY\n",
        "  CASE\n",
        "    WHEN average_rating >= 4.5 THEN '4.5-5.0'\n",
        "    WHEN average_rating >= 4.0 THEN '4.0-4.5'\n",
        "    WHEN average_rating >= 3.5 THEN '3.5-4.0'\n",
        "    WHEN average_rating >= 3.0 THEN '3.0-3.5'\n",
        "    WHEN average_rating >= 2.5 THEN '2.5-3.0'\n",
        "    WHEN average_rating >= 2.0 THEN '2.0-2.5'\n",
        "    ELSE '0.0-2.0'\n",
        "  END\n",
        "ORDER BY\n",
        "  rating_range DESC"
      ],
      "catalog": "workspace",
      "schema": "default"
    },
    {
      "name": "genre_filter",
      "displayName": "Genre Filter Options",
      "queryLines": [
        "SELECT DISTINCT\n",
        "  genre\n",
        "FROM\n",
        "  workspace.default.dim_books\n",
        "  LATERAL VIEW EXPLODE(genres) AS genre\n",
        "WHERE\n",
        "  genre IS NOT NULL\n",
        "ORDER BY\n",
        "  genre"
      ],
      "catalog": "workspace",
      "schema": "default"
    }
  ],
