{
  "datasets": [
    {
      "name": "genre_ratings",
      "displayName": "Genre Average Ratings",
      "queryLines": [
        "SELECT\n",
        "  genre,\n",
        "  AVG(average_rating) as avg_rating,\n",
        "  COUNT(*) as book_count\n",
        "FROM\n",
        "  workspace.default.dim_books\n",
        "  LATERAL VIEW EXPLODE(genres) AS genre\n",
        "WHERE\n",
        "  genre IS NOT NULL\n",
        "GROUP BY\n",
        "  genre\n",
        "HAVING\n",
        "  COUNT(*) >= 1000\n",
        "ORDER BY\n",
        "  avg_rating DESC"
      ],
      "catalog": "workspace",
      "schema": "default"
    },
    {
      "name": "5d0d55a5",
      "displayName": "books",
      "config": {
        "version": "1.1",
        "source": "workspace.default.books",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
